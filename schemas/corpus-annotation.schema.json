{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pte-100.org/schemas/corpus-annotation.schema.json",
  "title": "PTE-100 corpus annotation",
  "type": "object",
  "required": ["schema", "unit_id", "source_id", "sha256", "decision", "applicable_rules", "rationale"],
  "properties": {
    "schema": {"const": "pte-corpus-annotation@0.1"},
    "unit_id": {"type": "string", "minLength": 1},
    "source_id": {"type": "string", "minLength": 1},
    "source_url": {"type": "string", "format": "uri"},
    "license": {"type": "object"},
    "element": {"type": "string"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "text": {"type": "string"},
    "diagnostics": {"type": "array"},
    "decision": {"enum": ["uncertain", "compliant", "violation", "not_applicable"]},
    "applicable_rules": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^R[0-9]{3}$"}},
    "rationale": {"type": "string"},
    "reviewer": {"type": ["string", "null"]},
    "reviewed_at": {"type": ["string", "null"]}
  },
  "additionalProperties": true
}
