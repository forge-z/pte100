{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge-z.github.io/pte100/schemas/vocabulary-1.json",
  "title": "Pacote de vocabulário PTE",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "version", "title", "locales", "status", "concepts"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9.-]+$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"},
    "title": {"type": "string", "minLength": 1},
    "locales": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z]{2,3}(?:-[A-Z]{2})?$"}},
    "status": {"enum": ["experimental", "active", "deprecated", "retired"]},
    "concepts": {
      "type": "array",
      "items": {"$ref": "#/$defs/concept"}
    }
  },
  "$defs": {
    "concept": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "preferred", "part_of_speech", "definition", "admitted", "forbidden", "example"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9.-]+-C[0-9]{4,}$"},
        "preferred": {"type": "string", "minLength": 1},
        "part_of_speech": {"enum": ["noun", "verb", "adjective", "adverb", "adverbial_phrase", "other"]},
        "definition": {"type": "string", "minLength": 10},
        "admitted": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "forbidden": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["term", "replacement", "reason"],
              "properties": {
              "term": {"type": "string"},
              "replacement": {"type": "string"},
              "reason": {"type": "string"},
              "allowed_contexts": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["id", "patterns"],
                  "properties": {
                    "id": {"type": "string"},
                    "patterns": {"type": "array", "items": {"type": "string"}}
                  },
                  "additionalProperties": false
                }
              }
            }
          }
        },
        "example": {"type": "string", "minLength": 1}
      }
    }
  }
}
