<button
  type="button"
  id="theme-toggle"
  class="theme-toggle"
  aria-label="Alternar para tema escuro"
  aria-pressed="false"
  title="Tema claro — alternar para escuro"
>
  <span class="theme-toggle__orbit" aria-hidden="true">
    <svg class="theme-toggle__svg" viewBox="0 0 24 24" focusable="false">
      <g class="theme-toggle__sun">
        <circle cx="12" cy="12" r="3.25" />
        <g transform="rotate(0 12 12)"><rect x="11" y="2.75" width="2" height="4.35" rx="1" /></g>
        <g transform="rotate(45 12 12)"><rect x="11" y="2.75" width="2" height="4.35" rx="1" /></g>
        <g transform="rotate(90 12 12)"><rect x="11" y="2.75" width="2" height="4.35" rx="1" /></g>
        <g transform="rotate(135 12 12)"><rect x="11" y="2.75" width="2" height="4.35" rx="1" /></g>
        <g transform="rotate(180 12 12)"><rect x="11" y="2.75" width="2" height="4.35" rx="1" /></g>
        <g transform="rotate(225 12 12)"><rect x="11" y="2.75" width="2" height="4.35" rx="1" /></g>
        <g transform="rotate(270 12 12)"><rect x="11" y="2.75" width="2" height="4.35" rx="1" /></g>
        <g transform="rotate(315 12 12)"><rect x="11" y="2.75" width="2" height="4.35" rx="1" /></g>
      </g>
      <g class="theme-toggle__moon">
        <path
          d="M16.2 12c0-3.45-2.45-6.4-5.85-7.35 2.75 1.15 4.7 3.85 4.7 7.35s-1.95 6.2-4.7 7.35c3.4-.95 5.85-3.9 5.85-7.35z"
        />
      </g>
    </svg>
  </span>
</button>
<script is:inline>
  (() => {
    const key = 'pte100-theme';
    const root = document.documentElement;
    const button = document.querySelector('#theme-toggle');
    if (!button) return;

    const media = matchMedia('(prefers-color-scheme: dark)');
    const meta = document.querySelector('meta[name="theme-color"]');
    const labels = {
      light: {
        label: 'Alternar para tema escuro',
        title: 'Tema claro — alternar para escuro',
        pressed: 'false',
      },
      dark: {
        label: 'Alternar para tema claro',
        title: 'Tema escuro — alternar para claro',
        pressed: 'true',
      },
    };

    const readStored = () => {
      const saved = localStorage.getItem(key);
      return saved === 'light' || saved === 'dark' ? saved : null;
    };

    const isDark = (stored) => (stored === 'dark' ? true : stored === 'light' ? false : media.matches);

    const apply = (stored) => {
      const dark = isDark(stored);
      root.dataset.theme = dark ? 'dark' : 'light';
      if (meta) meta.content = dark ? '#111a24' : '#ffffff';
      const copy = dark ? labels.dark : labels.light;
      button.setAttribute('aria-label', copy.label);
      button.setAttribute('title', copy.title);
      button.setAttribute('aria-pressed', copy.pressed);
    };

    apply(readStored());

    button.addEventListener('click', () => {
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      localStorage.setItem(key, next);
      apply(next);
    });

    media.addEventListener('change', () => {
      if (!readStored()) apply(null);
    });
  })();
</script>
